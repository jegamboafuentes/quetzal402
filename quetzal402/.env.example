# Copy to .env and fill in real values. Never commit .env.

# CDP API keys for the x402 facilitator
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret

# Wallet that receives Boost deposits and holds the prize vault on-chain.
# MAINNET: set this to a secure Base Mainnet address that will hold REAL USDC.
# The matching VAULT_RECEIVER_PRIVATE_KEY is required so the server can pay winners.
VAULT_RECEIVER_ADDRESS=0xYourSecureMainnetVaultAddress
VAULT_RECEIVER_PRIVATE_KEY=your_vault_wallet_private_key

PORT=3000

# Default x402 network when the client omits ?network= or x-payment-network
# "base" = Base Mainnet (real USDC)
# "base-sepolia" = Base Sepolia testnet
DEFAULT_X402_NETWORK=base
